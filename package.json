{
  "name": "dsh-plugin-shop-dashboard",
  "version": "0.7.1",
  "type": "module",
  "description": "店铺数据看板：把「店铺账号管理」采集到的报表工作簿聚合成四组经营指标（经营总览/流量转化/商品供给/运营推广），支持时间范围（近 7/14/30/90 天、本月、上月、自定义起止日期）、走势粒度、按平台口径、卡片/表格双视图与 CSV 导出。",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "dashboard",
    "ecommerce"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "test",
    "tools"
  ],
  "scripts": {
    "check": "node tools/check-syntax.mjs",
    "test": "node test/features.mjs && node test/smoke.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monagisa/dsh-plugin-shop-dashboard.git"
  },
  "homepage": "https://github.com/monagisa/dsh-plugin-shop-dashboard#readme",
  "bugs": {
    "url": "https://github.com/monagisa/dsh-plugin-shop-dashboard/issues"
  }
}
