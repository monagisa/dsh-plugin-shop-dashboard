    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "test",
    "tools"
  ],
  "scripts": {
    "check": "node tools/check-syntax.mjs",
    "test": "node test/features.mjs"
